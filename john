class VaultFile {
  final String name;
  final String type;
  final String size;
  final String date;
  final IconData icon;
  final Color color;
  final bool favorite;
  final bool secure;

  const VaultFile({
    required this.name,
    required this.type,
    required this.size,
    required this.date,
    required this.icon,
    required this.color,
    this.favorite = false,
    this.secure = false,
  });
}

