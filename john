class SmartVaultApp extends StatefulWidget {
  const SmartVaultApp({super.key});

  @override
  State<SmartVaultApp> createState() => _SmartVaultAppState();
}

class _SmartVaultAppState extends State<SmartVaultApp> {
  bool darkMode = true;

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'Smart Vault',
      themeMode: darkMode ? ThemeMode.dark : ThemeMode.light,
      theme: ThemeData(
        useMaterial3: true,
        brightness: Brightness.light,
        colorSchemeSeed: const Color(0xFF6C63FF),
        scaffoldBackgroundColor: const Color(0xFFF5F7FB),
      ),
      darkTheme: ThemeData(
        useMaterial3: true,
        brightness: Brightness.dark,
        colorSchemeSeed: const Color(0xFF7C6CFF),
        scaffoldBackgroundColor: const Color(0xFF080A12),
        cardColor: const Color(0xFF111522),
      ),
      home: SmartVaultHome(
        darkMode: darkMode,
        onThemeChanged: (value) {
          setState(() {
            darkMode = value;
          });
        },
      ),
    );
  }
}

