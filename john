      case 1:
        return _filesPage();
      case 2:
        return _recentPage();
      case 3:
        return _favoritesPage();
      case 4:
        return _secureVaultPage();
      case 5:
        return _aiPage();
      case 6:
        return _settingsPage();
      default:
        return _dashboardPage();
    }
  }

